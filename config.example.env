# NetGuard works without an environment file. These examples are optional.
# NetGuard does not automatically load .env files. Set selected values in the
# shell environment; this file is a safe reference for their names.

# Browser mode stays loopback-only by default.
NETGUARD_HOST=127.0.0.1
NETGUARD_PORT=5000

# Optional database override. Relative paths resolve from the project folder.
# NETGUARD_DB_PATH=data/netguard.db

# Use lower detection thresholds only in an isolated authorized lab.
NETGUARD_DEVELOPMENT_MODE=false

# Retention is disabled until explicitly enabled.
NETGUARD_RETENTION_ENABLED=false
NETGUARD_RETENTION_PACKET_DAYS=30
NETGUARD_RETENTION_CONNECTION_DAYS=30
NETGUARD_RETENTION_STATISTICS_DAYS=90
NETGUARD_RETENTION_SCORE_DAYS=365
# NETGUARD_RETENTION_ALERT_DAYS=90
# NETGUARD_RETENTION_SESSION_DAYS=365

# Dashboard polling preferences are browser-local settings, not environment
# variables. Configure them on the Settings page.
